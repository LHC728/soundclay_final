STT_PROVIDER=mock
SENSEVOICE_MODEL=iic/SenseVoiceSmall
SENSEVOICE_DEVICE=cpu
SENSEVOICE_LANGUAGE=auto
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=zh
WHISPER_BEAM_SIZE=1
EMOTION_PROVIDER=hybrid
EMOTION_BASE_URL=https://aiping.cn/api/v1
EMOTION_MODEL=GLM-5.2
EMOTION_SOFT_TIMEOUT_SECONDS=1.5
EMOTION_TIMEOUT_SECONDS=3
EMOTION_CIRCUIT_FAILURES=3
EMOTION_CIRCUIT_SECONDS=30
# Put the key only in backend/.env. Blank means instant local-fusion fallback.
EMOTION_API_KEY=
STT_TIMEOUT_SECONDS=120
FRONTEND_ORIGIN=http://localhost:5173
AUDIO_OUTPUT_DIR=./audio
WORKS_OUTPUT_DIR=../works
MOCK_TRANSCRIPT=今天一直出错，我真的很烦。
ABLETON_OSC_ENABLED=false
ABLETON_OSC_HOST=127.0.0.1
ABLETON_OSC_PORT=11000
ABLETON_MIDI_ENABLED=false
ABLETON_MIDI_PORT=SoundClay MIDI
ABLETON_MIDI_CHANNEL=0
ABLETON_MIDI_GAIN_FLOOR=0.4
ABLETON_MIDI_MAX_HZ=50

# OBS application-audio capture target (Windows executable name).
OBS_ABLETON_EXECUTABLE=Ableton Live 12 Suite.exe

# RingRuntime is bundled under backend/ and remains opt-in so tests and mock
# replay never require hardware. SOUNDCLAY_RING_PATH is only for overriding it.
SOUNDCLAY_RING_ENABLED=false
SOUNDCLAY_RING_PATH=
SOUNDCLAY_RING_ADDRESS=FA:7E:92:E6:38:6D
SOUNDCLAY_SESSION_ROOT=./runtime/sessions
SOUNDCLAY_FFMPEG=ffmpeg
SOUNDCLAY_RING_EVENT_HZ=20
SOUNDCLAY_TWIST_SIGN=1
SOUNDCLAY_TILT_X_SIGN=-1
SOUNDCLAY_TILT_X_DEADZONE_DEG=4
SOUNDCLAY_TILT_X_ENTER_DEG=8
SOUNDCLAY_TILT_X_RETURN_DEG=5
SOUNDCLAY_TILT_X_NEUTRAL_DWELL_MS=300
SOUNDCLAY_TILT_X_FULL_SCALE_DEG=40
SOUNDCLAY_BURST_THRESHOLD=0.7
